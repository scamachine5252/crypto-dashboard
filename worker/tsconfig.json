{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "../dist/worker",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": "..",
    "paths": {
      "@/*": ["./*"],
      "server-only": ["worker/noop.ts"]
    },
    "skipLibCheck": true
  },
  "include": ["../worker/**/*", "../lib/**/*"],
  "exclude": ["../node_modules", "../app", "../components", "../lib/__tests__", "../lib/auth-context.tsx", "../lib/theme-context.tsx"]
}
